# External Secrets Operator, installé par le contrôleur Helm intégré à k3s
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: external-secrets
  namespace: kube-system
spec:
  repo: https://charts.external-secrets.io
  chart: external-secrets
  version: "${external_secrets_version}"
  targetNamespace: external-secrets
  createNamespace: true
  valuesContent: |-
    installCRDs: true
---
# Magasin utilisé par les ExternalSecret de coursesplanner-docker.
# Sans bloc auth : l'opérateur s'authentifie avec le compte de service de la VM
# (serveur de métadonnées), aucune clé n'est stockée dans le cluster.
# Tant que le chart n'a pas installé les CRD, k3s réessaie d'appliquer cet objet.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: gcp-secret-manager
spec:
  provider:
    gcpsm:
      projectID: ${project_id}
